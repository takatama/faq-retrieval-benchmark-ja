  "faqs": [
    {
      "id": "faq-01",
      "title": "通勤定期代の申請",
      "category": "経費",
      "answer": "自宅から所属オフィスまでの通勤定期代は、人事ポータルの「通勤費」から申請します。出張や取引先への訪問で使った交通費は、経費システムの「出張交通費」から申請してください。"
    },
    {
      "id": "faq-02",
      "title": "出張・外出の交通費精算",
      "category": "経費",
      "answer": "業務で電車や路線バスを使った場合は、利用日・区間・目的・金額を経費システムの「出張交通費」に入力します。公共交通機関の通常の運賃は、領収書がなくても申請できます。タクシー代には領収書が必要です。"
    },
    {
      "id": "faq-03",
      "title": "領収書をなくしたとき",
      "category": "経費",
      "answer": "備品や会食など、領収書が必要な支払いで原本をなくした場合は、まず購入先に再発行を依頼してください。再発行できない場合は、支払日・内容・金額を添えて経理に相談します。通常の電車・路線バスの運賃は「出張交通費」の手順を確認してください。"
    },
    {
      "id": "faq-04",
      "title": "自宅から社内システムに接続する",
      "category": "IT",
      "answer": "自宅のネットワークから社内システムを使う場合は、会社のPCでVPNアプリを起動して接続します。社用アカウントと認証アプリの確認コードが必要です。認証アプリを使えなくなった場合は、確認コードの再登録を依頼してください。"
    },
    {
      "id": "faq-05",
      "title": "認証アプリの再登録",
      "category": "IT",
      "answer": "スマートフォンの機種変更や故障で、会社へのログインに使う確認コードを表示できなくなった場合は、ITサポートへ「多要素認証の再登録」を申請します。本人確認後、新しい端末で認証アプリを設定します。会社のPCを交換する手続きとは別です。"
    },
    {
      "id": "faq-06",
      "title": "会社のPCを交換する",
      "category": "IT",
      "answer": "会社のPCを買い替え・交換する場合は、端末管理フォームから申請します。新しいPCの初期設定と、旧PCの返却日をITサポートと調整します。スマートフォンの認証アプリだけを変更したい場合は、認証アプリの再登録を使います。"
    },
    {
      "id": "faq-07",
      "title": "オフィスのWi-Fiを使う",
      "category": "IT",
      "answer": "会社のPCはオフィスの社内用Wi-Fiに自動接続します。来客には受付でゲスト用ネットワークを案内します。接続できない場合は、使用している端末とエラー画面をITサポートへ連絡してください。"
    },
    {
      "id": "faq-08",
      "title": "住所・連絡先を変更する",
      "category": "人事",
      "answer": "引っ越しなどで自宅住所や電話番号が変わった場合は、人事ポータルの「個人情報」から更新してください。通勤経路や通勤定期代が変わる場合は、「通勤費」の変更申請も別途必要です。"
    },
    {
      "id": "faq-09",
      "title": "通勤経路を変更する",
      "category": "人事",
      "answer": "引っ越しや利用路線の変更で通勤経路が変わる場合は、人事ポータルの「通勤費」から新しい経路と適用開始日を申請します。自宅住所の更新だけでは、通勤費の申請内容は変わりません。"
    },
    {
      "id": "faq-10",
      "title": "給与の振込口座を変更する",
      "category": "人事",
      "answer": "給与の振込先を変更する場合は、人事ポータルの「給与口座」から申請します。毎月10日までの申請は、原則として当月分から反映します。住所や通勤費の変更とは別の手続きです。"
    },
    {
      "id": "faq-11",
      "title": "社員証を紛失したとき",
      "category": "総務",
      "answer": "社員証をなくした場合は、気付いた時点で総務へ連絡してください。入館権限を停止し、仮の入館証を発行します。再発行の申請も総務で受け付けます。会社のPCの紛失は、ITサポートにも至急連絡してください。"
    },
    {
      "id": "faq-12",
      "title": "プリンターで印刷する",
      "category": "IT",
      "answer": "オフィスのプリンターでは、会社のPCから印刷ジョブを送信し、プリンターに社員証をかざして出力します。社員証が反応しない場合は、受付の案内に従って一時コードを使ってください。"
    },
    {
      "id": "faq-13",
      "title": "会議室を予約する",
      "category": "総務",
      "answer": "社内カレンダーで空き時間を確認し、会議室を参加者として追加して予約します。来客がある場合は、受付への来訪者登録も必要です。会議室を使わなくなった場合は予約を取り消してください。"
    },
    {
      "id": "faq-14",
      "title": "仕事で使う備品を購入する",
      "category": "総務",
      "answer": "業務で使う備品は、購入前に上長の承認を受けて備品購入フォームから申請します。立て替えた場合は、承認記録と領収書を添えて経費精算してください。会社のPCは端末交換の手続きから申請します。"
    },
    {
      "id": "faq-15",
      "title": "法人カードの利用明細を精算する",
      "category": "経費",
      "answer": "法人カードの支払いも、経費システムで利用目的と領収書を登録します。交通費を個人で立て替えた場合は、法人カードの明細ではなく「出張交通費」から申請します。"
    },
    {
      "id": "faq-16",
      "title": "急な事情で休暇を取りたい",
      "category": "人事",
      "answer": "家族の体調不良などで急に休む場合は、まず上長へ連絡し、その後に勤怠システムで休暇を申請してください。在宅勤務への変更を希望する場合も、休暇扱いにせず事前に上長と相談します。"
    },
    {
      "id": "faq-17",
      "title": "在宅勤務の日を変更する",
      "category": "人事",
      "answer": "予定していた出社日を在宅勤務へ変える場合は、業務への影響を上長と確認し、勤怠システムの勤務場所を更新します。家族の対応などで業務を行えない時間は、休暇などの扱いを別途相談してください。"
    },
    {
      "id": "faq-18",
      "title": "会社へ届く荷物を受け取る",
      "category": "総務",
      "answer": "社員宛ての業務用の荷物は、平日9時から18時まで受付で受け付けます。到着後、宛名の社員へ通知します。当日受け取れない場合は受付で一時保管します。私物の配送先に会社を指定することはできません。"
    }
  ],
